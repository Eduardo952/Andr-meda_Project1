# Copie os NOMES abaixo para os Secrets do Lovable (não commite valores reais).
# Tudo é opcional: sem nada configurado o jogo roda 100% offline (templates + snapshots).

# --- n8n (webhooks do workflow n8n/mars-bubble-groq-nasa_workflow.json) ---
# Prefixo dos webhooks de PRODUÇÃO (workflow ativo): <seu-n8n>/webhook
# N8N_BASE_URL=https://n8n.rvcarbon.com.br/webhook   (alternativa: deriva as duas URLs abaixo)
N8N_WEBHOOK_URL=https://n8n.rvcarbon.com.br/webhook/bubble-narrator
N8N_NASA_URL=https://n8n.rvcarbon.com.br/webhook/nasa-sol
# Mesmo valor de WEBHOOK_SECRET dentro do node CONFIG do workflow (enviado como x-api-key)
N8N_WEBHOOK_SECRET=

# --- Fallback direto na NASA (só usado se o n8n não responder) ---
# NASA_API_KEY=
# NASA_ALLOW_DEMO_KEY=false
